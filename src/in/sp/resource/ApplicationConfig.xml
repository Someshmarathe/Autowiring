<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="in.sp.bean.Student" id="student">
        <property name="id" value="101"/>
        <property name="name" value="Somesh"/>
        <property name="email" value="somesh@gmail.com"/>
        <property name="address" ref="address"/>
    </bean>

    <bean class="in.sp.bean.Address" id="address" >
        <property name="pincode" value="450112"/>
        <property name="city" value="Indore"/>
        <property name="State" value="MP"/>
    </bean>



</beans>